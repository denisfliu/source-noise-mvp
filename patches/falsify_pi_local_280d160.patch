diff --git a/tools/gate_pi0/probe_action_space.py b/tools/gate_pi0/probe_action_space.py
new file mode 100644
index 0000000..c71d4bc
--- /dev/null
+++ b/tools/gate_pi0/probe_action_space.py
@@ -0,0 +1,106 @@
+"""In-process probe: does the gate pi0 policy return per-step deltas or
+absolute MOCAP targets?
+
+Discriminator: infer twice on the SAME image at two state altitudes (z and
+z + 1.0). If the returned action column 2 shifts by ~1.0, openpi's
+``AbsoluteActions`` output transform is adding ``state`` to every row (chunk is
+absolute). If it does not shift and the columns sit inside the action
+norm-stats envelope, the chunk is per-step deltas and must be cumsum-integrated
+(falsify ``--action-space delta``).
+
+Runs both the fixed ``pi0_gate`` config and a copy with the delta/absolute push
+restored, so the two are compared side by side in one process.
+
+    env -u VIRTUAL_ENV XLA_PYTHON_CLIENT_PREALLOCATE=false \
+        ~/code/openpi/.venv/bin/python tools/gate_pi0/probe_action_space.py \
+        --ckpt local/checkpoints/gate_both_scratch --norm local/assets/gate_nav
+"""
+import argparse
+import dataclasses
+import json
+
+import numpy as np
+
+import openpi.training.config as _cfg
+import openpi.policies.policy_config as _pc
+import openpi.shared.normalize as _nz
+import openpi.transforms as _transforms
+from openpi.transforms import NormStats
+
+
+PROMPT = "go through the gate on the left and hover over the stuffed animal"
+
+
+def pad_stats(ns: dict[str, NormStats], dim: int) -> dict[str, NormStats]:
+    out = {}
+    for k, s in ns.items():
+        n = np.asarray(s.mean).shape[-1]
+        if n >= dim:
+            out[k] = s
+            continue
+        pad = dim - n
+
+        def ext(arr, fill):
+            return None if arr is None else np.concatenate(
+                [np.asarray(arr, np.float32), np.full(pad, fill, np.float32)])
+
+        out[k] = NormStats(mean=ext(s.mean, 0.0), std=ext(s.std, 1.0),
+                           q01=ext(s.q01, 0.0), q99=ext(s.q99, 1.0))
+    return out
+
+
+def query(policy, state, image):
+    out = policy.infer({
+        "observation/image": image,
+        "observation/wrist_image": image,
+        "observation/state": np.asarray(state, np.float32),
+        "prompt": PROMPT,
+    })
+    return np.asarray(out["actions"])[:, :7]
+
+
+def report(tag, policy, image, lo, hi):
+    a0 = query(policy, lo, image)
+    a1 = query(policy, hi, image)
+    print(f"\n=== {tag} ===")
+    print(f"  chunk shape {a0.shape}")
+    print("  state z=1.5 col[min,max]:", " ".join(
+        f"c{i}[{a0[:, i].min():+.4f},{a0[:, i].max():+.4f}]" for i in range(4)))
+    print("  state z=2.5 col[min,max]:", " ".join(
+        f"c{i}[{a1[:, i].min():+.4f},{a1[:, i].max():+.4f}]" for i in range(4)))
+    print(f"  shift of mean(col2) when state z += 1.0: {a1[:, 2].mean() - a0[:, 2].mean():+.4f}")
+    print("  cumsum over 8 steps [:4]:", np.round(a0[:8].cumsum(0)[-1, :4], 4))
+    print("  cumsum over 50 steps[:4]:", np.round(a0.cumsum(0)[-1, :4], 4))
+    return a0
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--ckpt", default="local/checkpoints/gate_both_scratch")
+    ap.add_argument("--norm", default="local/assets/gate_nav")
+    a = ap.parse_args()
+
+    rng = np.random.default_rng(0)
+    image = (rng.random((224, 224, 3)) * 255).astype(np.uint8)
+    lo = np.array([0.0, 0.0, 1.5, 0.0, 0.0, 0.0, 0.0], np.float32)
+    hi = lo.copy()
+    hi[2] += 1.0
+
+    cfg = _cfg.get_config("pi0_gate")
+    ns = pad_stats(_nz.load(a.norm), cfg.model.action_dim)
+
+    stats = json.load(open(f"{a.norm}/norm_stats.json"))["norm_stats"]["actions"]
+    print("norm_stats actions mean[:4]", np.round(stats["mean"][:4], 5))
+    print("norm_stats actions std [:4]", np.round(stats["std"][:4], 5))
+    print("norm_stats actions q99 [:4]", np.round(stats["q99"][:4], 5))
+
+    dc = cfg.data.create(cfg.assets_dirs, cfg.model)
+    print("data_transforms.inputs :", [type(t).__name__ for t in dc.data_transforms.inputs])
+    print("data_transforms.outputs:", [type(t).__name__ for t in dc.data_transforms.outputs])
+
+    pol = _pc.create_trained_policy(cfg, a.ckpt, norm_stats=ns)
+    report("pi0_gate (fixed: no DeltaActions/AbsoluteActions)", pol, image, lo, hi)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/gate_pi0/upload_gsplat_hf.py b/tools/gate_pi0/upload_gsplat_hf.py
new file mode 100644
index 0000000..c9aa658
--- /dev/null
+++ b/tools/gate_pi0/upload_gsplat_hf.py
@@ -0,0 +1,53 @@
+"""One-shot upload of the falsify gate gsplat assets to a HF dataset repo.
+
+Mirrors ~/los_tts/upload_hf.py's auth: reads a write token from
+~/los_tts/.hf_token (never passed on the command line) and pushes via HfApi.
+Uploads data/gate_scenes_export/ (the two sagesplat scenes + objects_final)
+to a dataset repo <user>/gate-gsplat-assets, EXCLUDING the ~1.2 GB of
+TensorBoard training logs (*tfevents*) that rendering doesn't need. Resumable
+and idempotent (upload_large_folder) — rerun to finish an interrupted push.
+
+Run with a python that has huggingface_hub, e.g. the same venv the tts
+uploader uses:
+
+  ~/venvs/chatterbox-tts/bin/python tools/gate_pi0/upload_gsplat_hf.py
+
+Then the other machine fetches the assets into the path the scene YAMLs expect:
+
+  hf download <user>/gate-gsplat-assets --repo-type dataset \
+      --local-dir data/gate_scenes_export
+"""
+import sys
+from pathlib import Path
+
+from huggingface_hub import HfApi
+
+TOKEN_FILE = Path.home() / "los_tts" / ".hf_token"
+# tools/gate_pi0/upload_gsplat_hf.py -> repo root is parents[2]
+FOLDER = Path(__file__).resolve().parents[2] / "data" / "gate_scenes_export"
+REPO_NAME = "gate-gsplat-assets"
+
+
+def main():
+    if not TOKEN_FILE.exists():
+        sys.exit(f"no HF token at {TOKEN_FILE}")
+    if not FOLDER.exists():
+        sys.exit(f"no gsplat assets at {FOLDER}")
+    token = TOKEN_FILE.read_text().strip()
+    api = HfApi(token=token)
+    user = api.whoami()["name"]
+    repo_id = f"{user}/{REPO_NAME}"
+    api.create_repo(repo_id, repo_type="dataset", exist_ok=True, private=False)
+    print(f"authenticated as {user}; uploading {FOLDER} -> {repo_id} "
+          f"(excluding *tfevents*)", flush=True)
+    api.upload_large_folder(
+        repo_id=repo_id,
+        repo_type="dataset",
+        folder_path=str(FOLDER),
+        ignore_patterns=["*tfevents*"],
+    )
+    print(f"done: https://huggingface.co/datasets/{repo_id}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
