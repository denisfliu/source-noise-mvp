@@ -0,0 +1,236 @@
+"""Extract the EXACT gsplat render spec for configs/scenes/left_gate.yaml so the
+render can be reproduced in a standalone gsplat-1.5.3 script (no nerfstudio/FiGS).
+
+Reuses falsify's own render path: builds the FrameGraph + GSplatRenderer, places
+the forward camera at the drone start pose (mocap [0,0,1.5], yaw 0), and renders.
+It monkeypatches nerfstudio-splatfacto's `project_gaussians` + `rasterize_gaussians`
+to capture the exact tensors the rasterizer receives (viewmat, K, activated
+scales/quats/opacities/colors), so the activation recipe is measured, not guessed.
+
+Dumps everything (exact, unrounded) to tools/gate_pi0/render_spec_dump/.
+Run under tools/env.sh:
+  source tools/env.sh
+  PYTHONPATH=src:external/FiGS/src:external/splatnav .venv/bin/python \
+      tools/gate_pi0/extract_render_spec.py
+"""
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+REPO = Path(__file__).resolve().parents[2]
+OUT = REPO / "tools" / "gate_pi0" / "render_spec_dump"
+OUT.mkdir(parents=True, exist_ok=True)
+
+from falsify.io import load_yaml, build_frame_graph
+from falsify.sim.renderer import GSplatRenderer
+from falsify.sim.poses import camera_to_world_pose
+from falsify.sensors.camera import make_camera_sensor_from_yaml
+from falsify.orchestrator.orchestrator import build_initial_state
+
+SCENE = REPO / "configs/scenes/left_gate.yaml"
+FRAME = REPO / "configs/frames/carl_dual.yaml"
+
+
+def dump_np(name, arr):
+    arr = np.asarray(arr)
+    np.save(OUT / f"{name}.npy", arr)
+    return arr.tolist()
+
+
+def main():
+    report = {}
+    scene_cfg = load_yaml(SCENE)
+    frame_cfg = load_yaml(FRAME)
+    scene_dir = SCENE.parent
+    fg = build_frame_graph(scene_cfg, base_path=scene_dir)
+
+    renderer = GSplatRenderer.from_scene_cfg(scene_cfg, scene_dir=scene_dir)
+    pipe = renderer.pipeline
+    model = pipe.model
+
+    # ---- (1) world->model transforms -------------------------------------
+    dpo = pipe.datamanager.train_dataparser_outputs
+    dp_transform = dpo.dataparser_transform.cpu().numpy()   # (3,4)
+    dp_scale = float(dpo.dataparser_scale)
+    Tw2g = np.asarray(renderer._impl.Tw2g)                   # (4,4) NED->NS (model frame)
+    report["1_world_to_model"] = {
+        "dataparser_transform_3x4": dump_np("dataparser_transform", dp_transform),
+        "dataparser_scale": dp_scale,
+        "Tw2g_4x4": dump_np("Tw2g", Tw2g),
+        "Tw2g_input_frame": renderer.world_frame,     # "ned"
+        "Tw2g_output_frame": "ns (nerfstudio/model frame the gaussians live in)",
+        "note": "renderer applies Tc2g = Tw2g @ T_c2w; camera_to_worlds handed to splatfacto is camera->NS.",
+    }
+
+    # ---- reference camera pose (forward cam @ start) ---------------------
+    state = build_initial_state(scene_cfg, fg, rng=None)     # NED, quat identity (yaw 0)
+    fwd = make_camera_sensor_from_yaml(
+        "forward", frame_cfg["cameras"]["forward"], fg,
+        renderer=renderer.render, body_to_world=camera_to_world_pose)
+    cam_pose = camera_to_world_pose(state, fwd.spec.body_from_camera)   # Pose in NED
+    T_c2w_ned = cam_pose.as_matrix()
+    report["ref_pose"] = {
+        "drone_pos_mocap": scene_cfg["start_position_mocap"],
+        "drone_quat_xyzw_ned": state.quat_xyzw.tolist(),
+        "drone_pos_ned": state.pos.xyz.tolist(),
+        "T_c2w_ned_4x4": dump_np("T_c2w_ned", T_c2w_ned),
+        "intrinsics": dict(fwd.spec.intrinsics),
+    }
+
+    # ---- (2) capture the exact rasterizer inputs -------------------------
+    # The model is `sagesplat`, not vanilla splatfacto — it imports
+    # project_gaussians / rasterize_gaussians into its OWN module namespace.
+    # Patch every loaded module that holds the gsplat functions.
+    import sys
+    cap = {}
+    restore = []  # (module, name, original)
+
+    def install(name, key):
+        for mod in list(sys.modules.values()):
+            fn = getattr(mod, name, None)
+            if fn is None:
+                continue
+            if not getattr(fn, "__module__", "").startswith("gsplat"):
+                continue
+            orig = fn
+            def spy(*a, _orig=orig, _key=key, **k):
+                cap.setdefault(_key + "_calls", []).append((a, k))
+                return _orig(*a, **k)
+            setattr(mod, name, spy)
+            restore.append((mod, name, orig))
+            cap.setdefault(key + "_patched_modules", []).append(mod.__name__)
+
+    install("project_gaussians", "proj")
+    install("rasterize_gaussians", "rast")
+    # gsplat 0.1.13 has no gsplat.rendering.rasterization, so sagesplat defines
+    # its OWN `rasterization` shim (gsplat-1.x API over 0.1.13). __module__ is
+    # sagesplat, so patch it directly — its call args are the gsplat-1.x call.
+    import sagesplat.sagesplat as _ss
+    _rz_orig = _ss.rasterization
+    def _rz_spy(*a, **k):
+        cap.setdefault("rz_calls", []).append((a, k))
+        return _rz_orig(*a, **k)
+    _ss.rasterization = _rz_spy
+    restore.append((_ss, "rasterization", _rz_orig))
+    try:
+        rgb, _ = renderer.render(cam_pose, fwd.spec.intrinsics)
+    finally:
+        for mod, name, orig in restore:
+            setattr(mod, name, orig)
+    report["patched_modules"] = {"project": cap.get("proj_patched_modules"),
+                                 "rasterize": cap.get("rast_patched_modules")}
+    report["model_class"] = f"{type(model).__module__}.{type(model).__name__}"
+
+    from PIL import Image
+    Image.fromarray(rgb).save(OUT / "reference_forward_render.png")
+
+    def as_np(x):
+        return x.detach().cpu().numpy() if torch.is_tensor(x) else x
+
+    def rng_str(x):
+        x = np.asarray(x, np.float64)
+        return {"min": float(x.min()), "max": float(x.max()), "shape": list(x.shape)}
+
+    # The real render is a single gsplat.rasterization(...) call (all kwargs).
+    # compute_semantics adds more calls; the FIRST is the RGB render.
+    rz = cap["rz_calls"][0][1]          # kwargs dict
+    viewmat = as_np(rz["viewmats"]).squeeze()          # (4,4) world(NS)->cam
+    K = as_np(rz["Ks"]).squeeze()                      # (3,3)
+    img_w, img_h = int(rz["width"]), int(rz["height"])
+    rz_scales = as_np(rz["scales"]); rz_quats = as_np(rz["quats"])
+    rz_opac = as_np(rz["opacities"]); rz_colors = as_np(rz["colors"])
+    try:
+        bg = as_np(model.background_color)
+    except Exception:
+        bg = None
+
+    report["2_reference_render"] = {
+        "renderer_api": "sagesplat's gsplat-1.x-API `rasterization` shim (running on gsplat 0.1.13). "
+                        "These are the exact kwargs to feed real gsplat-1.5.3 `rasterization(...)`.",
+        "viewmat_4x4_world_to_cam": dump_np("viewmat", np.asarray(viewmat)),
+        "K_3x3": dump_np("K", np.asarray(K)),
+        "width": img_w, "height": img_h,
+        "camera_convention": "viewmats = world(NS model frame)->camera, OpenCV axes (x-right, y-down, z-forward). "
+                             "get_viewmat: R=c2w_R*[1,-1,-1] (OpenGL->OpenCV flip), R_inv=R^T, T_inv=-R_inv@t.",
+        "rasterization_kwargs": {
+            "packed": bool(rz.get("packed", False)),
+            "near_plane": float(rz.get("near_plane", 0.0)),
+            "far_plane": float(rz.get("far_plane", 0.0)),
+            "render_mode": rz.get("render_mode"),
+            "sh_degree": (int(rz["sh_degree"]) if rz.get("sh_degree") is not None else None),
+            "rasterize_mode": rz.get("rasterize_mode"),
+        },
+        "background_color": (np.asarray(bg).tolist() if bg is not None else None),
+        "post": "rgb = render[...,:3] + (1-alpha)*background; rgb = clamp(rgb, 0, 1)",
+        "png": str((OUT / "reference_forward_render.png")),
+    }
+
+    # ---- (3) activation recipe (measured against raw params, no crop) -----
+    gp = model.gauss_params if hasattr(model, "gauss_params") else {
+        "means": model.means, "scales": model.scales, "quats": model.quats,
+        "opacities": model.opacities, "features_dc": model.features_dc,
+        "features_rest": model.features_rest}
+    raw = {k: as_np(v) for k, v in gp.items()}
+    shapes = {k: list(v.shape) for k, v in raw.items()}
+
+    sig_raw = 1.0 / (1.0 + np.exp(-raw["opacities"].reshape(-1).astype(np.float64)))
+    exp_raw = np.exp(raw["scales"].astype(np.float64))
+    recipe_checks = {
+        "n_rasterization_calls": len(cap["rz_calls"]),
+        "scales_arg == exp(raw_scales)  max_abs_diff": float(np.abs(rz_scales.astype(np.float64) - exp_raw).max()),
+        "opacities_arg == sigmoid(raw)  max_abs_diff": float(np.abs(rz_opac.reshape(-1).astype(np.float64) - sig_raw).max()),
+        "quats_arg == RAW ckpt quats    max_abs_diff": float(np.abs(rz_quats.astype(np.float64) - raw["quats"].astype(np.float64)).max()),
+        "colors_arg_shape (SH coeffs N,K,3)": list(np.asarray(rz_colors).shape),
+    }
+
+    report["3_activation"] = {
+        "gauss_param_shapes": shapes,
+        "sh_degree_config": int(getattr(model.config, "sh_degree", -1)),
+        "sh_degree_used_at_render": (int(rz["sh_degree"]) if rz.get("sh_degree") is not None else None),
+        "recipe_checks": recipe_checks,
+        "means_are_raw_ckpt": "means/quats are the raw ckpt params (model frame = NS); ONLY the camera is "
+                              "transformed via Tw2g. The dataparser transform is NOT applied to gaussians at load.",
+        "recipe": ("Pass to gsplat.rasterization: means=RAW means; quats=RAW quats (rasterization "
+                   "L2-normalizes internally); scales=exp(RAW scales); opacities=sigmoid(RAW opacities); "
+                   "colors=cat(features_dc[:,None,:], features_rest) as SH coeffs (N,16,3) with sh_degree=3 "
+                   "(gsplat does SH->RGB). Then rgb=render[...,:3]+(1-alpha)*bg; clamp(rgb,0,1)."),
+        "measured": {
+            "raw_scales_range": rng_str(raw["scales"]),
+            "raw_quats_norm_range (unnormalized in ckpt)": rng_str(np.linalg.norm(raw["quats"], axis=-1)),
+            "raw_opacities_range": rng_str(raw["opacities"]),
+            "rz_opacities_arg_range (sigmoid, [0,1])": rng_str(rz_opac),
+            "rz_colors_arg_shape": list(np.asarray(rz_colors).shape),
+        },
+    }
+
+    # dump raw gauss params for the standalone script + a sample slice
+    for k, v in raw.items():
+        np.save(OUT / f"gauss_{k}.npy", v)
+
+    # ---- splatfacto get_outputs source (ground truth for the recipe) -----
+    import inspect
+    try:
+        src = inspect.getsource(model.get_outputs)
+        (OUT / "splatfacto_get_outputs.txt").write_text(src)
+        report["3_activation"]["get_outputs_source"] = "tools/gate_pi0/render_spec_dump/splatfacto_get_outputs.txt"
+    except Exception as e:
+        report["3_activation"]["get_outputs_source"] = f"(unavailable: {e})"
+
+    # ---- (4) policy image spec -------------------------------------------
+    report["4_policy_image"] = {
+        "render_resolution": [img_w, img_h],
+        "resize_to": "image_size x image_size (square). Runs used image_size=224.",
+        "interpolation": "PIL BILINEAR (falsify.policy.camera_postprocess.CameraPostprocess step 1 / VLAPolicy._resize_image)",
+        "channel_order": "RGB (channel_order='RGB' default; renders are already RGB; no swap for this era)",
+        "note": "VLAPolicy sends observation/image as uint8 (image_size, image_size, 3) RGB after the resize.",
+    }
+
+    (OUT / "render_spec.json").write_text(json.dumps(report, indent=2))
+    print("WROTE", OUT / "render_spec.json")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
