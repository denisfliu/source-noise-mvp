+    logger.info(f"SNMVP pin enabled: U from {_pin_path} shape {_PIN_U.shape}")
+_PIN_NOISE = float(_os.environ.get("SNMVP_PIN_NOISE", "0"))
+_PIN_NOISE_RAND = _os.environ.get("SNMVP_PIN_NOISE_RAND", "") == "1"
