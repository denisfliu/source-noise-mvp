+# orthonormal D x K pin basis (QR of a free matrix) trained jointly with the flow,
+# plus an observation head P(prefix-pool) -> c whose variance-normalized error is
+# added to the loss WITHOUT stop-grad — the RRR predictability objective learned
+# end-to-end. SNMVP_LEARN_U_DIMS masks the basis to the leading real action dims
+# (padded dims are constant-zero => trivially predictable => collapse magnet).
+_LEARN_U_K = int(_os.environ.get("SNMVP_LEARN_U", "0"))
+_LEARN_U_LAM = float(_os.environ.get("SNMVP_LEARN_U_LAM", "1.0"))
+_LEARN_U_DIMS = int(_os.environ.get("SNMVP_LEARN_U_DIMS", "0"))
