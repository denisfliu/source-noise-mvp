+    _snmvp_inject = None
+_SNMVP_COND_DIMS = int(os.environ.get("SNMVP_COND_DIMS", "7"))
+_SNMVP_COND_STATS = (
+    _snmvp_load_stats(os.environ["SNMVP_COND_STATS"])
+    if _snmvp_inject is not None and os.environ.get("SNMVP_COND_STATS")
+    else None
+)
