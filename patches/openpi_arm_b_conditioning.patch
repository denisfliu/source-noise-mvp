+# --- snmvp: branch-carried invariant conditioning (arm B/D). Enable by setting
+# SNMVP_COND_STATS to the dataset's invariant_stats.json (see
+# source-noise-mvp/scripts/compute_invariant_stats.py). Inert when unset. ---
+try:
+    from snmvp.conditioning import inject_invariant_state as _snmvp_inject
+    from snmvp.conditioning import load_invariant_stats as _snmvp_load_stats
